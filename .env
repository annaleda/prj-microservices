# Credenziali di sviluppo locale per i database Docker.
# NON usare questi valori in staging/produzione.

AUTH_DB_NAME=auth
AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth
AUTH_DB_PORT=5433

CATALOG_DB_NAME=catalog
CATALOG_DB_USER=catalog
CATALOG_DB_PASSWORD=catalog
CATALOG_DB_PORT=5434

ORDERS_DB_NAME=orders
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=orders
ORDERS_DB_PORT=5435

PAYMENTS_DB_NAME=payments
PAYMENTS_DB_USER=payments
PAYMENTS_DB_PASSWORD=payments
PAYMENTS_DB_PORT=5436

INVENTORY_DB_NAME=inventory
INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory
INVENTORY_DB_PORT=5437

ANALYTICS_DB_NAME=analytics
ANALYTICS_DB_USER=analytics
ANALYTICS_DB_PASSWORD=analytics
ANALYTICS_DB_PORT=27017

KAFKA_HOST_PORT=9094
KAFKA_UI_PORT=8090

# Keycloak (identity provider). Usa auth-db come proprio database.
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
